# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git. Never put real keys in this file.

# Supabase project URL (Supabase dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key (Supabase dashboard > Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (Supabase dashboard > Project Settings > API Keys).
# On newer projects this is called the "secret" key and starts with sb_secret_.
# SECRET: it skips all database security rules. Server code only.
# It must NEVER get the NEXT_PUBLIC_ prefix, or it would be sent to browsers.
SUPABASE_SERVICE_ROLE_KEY=

# Show the "Continue with Google" button on the login and sign-up pages.
# Leave as false until Google sign-in is set up in the Supabase dashboard.
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false
